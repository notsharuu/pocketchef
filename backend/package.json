    "ingest": "python3 scripts/ingest_datasets.py",
    "build-vectordb": "node scripts/build_vector_db.js"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@huggingface/transformers": "^4.3.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
