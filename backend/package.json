{
  "name": "pocketchef-backend",
  "version": "1.0.0",
  "description": "Backend API for PocketChef fridge scanning and recipe assistant",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test tests/**/*.test.js",
